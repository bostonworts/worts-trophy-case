APP_SECRET_KEY=change-me-to-a-long-random-value
ADMIN_LOGIN_CODE=change-me-for-local-admin-login
ADMIN_SETUP_CODE=change-me-for-first-admin-only
LOCAL_LOGIN_ENABLED=true
SESSION_COOKIE_SECURE=false
WEB_PORT=8001
DB_PORT=5433
TROPHY_CASE_MOUNT_ROOT=/Users/Shared/Docker/trophy-case

# Local Docker defaults. Use service DNS inside compose.
DATABASE_URL=postgresql+psycopg://trophy:trophy@db:5432/trophy_case
UPLOAD_DIR=/uploads
UPLOAD_URL_PREFIX=/uploads
PUBLIC_BASE_URL=

# Optional member login email delivery. Without SMTP, local dev logs links and codes.
EMAIL_FROM=trophy-case@example.test
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Member login throttling and Google Sheet roster import.
ADMIN_LOGIN_ATTEMPT_LIMIT=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=3600
MEMBER_LOGIN_REQUEST_LIMIT=5
MEMBER_LOGIN_VERIFY_LIMIT=10
MEMBER_LOGIN_RATE_LIMIT_WINDOW_SECONDS=3600
GOOGLE_SHEET_FETCH_TIMEOUT_SECONDS=10
GOOGLE_SHEET_IMPORT_MAX_BYTES=2000000
