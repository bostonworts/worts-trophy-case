# Required production values.
APP_SECRET_KEY=
POSTGRES_PASSWORD=
ADMIN_LOGIN_CODE=
ACME_EMAIL=

# Required only for the first admin bootstrap; remove after the first admin exists.
ADMIN_SETUP_CODE=

# Optional production overrides.
POSTGRES_DB=trophy_case
POSTGRES_USER=trophy
LOCAL_LOGIN_ENABLED=true
SESSION_COOKIE_SECURE=true
PUBLIC_BASE_URL=https://trophycase.worts.club

# Required SMTP settings for production member login email delivery.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Optional member login throttling and Google Sheet import limits.
ADMIN_LOGIN_ATTEMPT_LIMIT=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=3600
MEMBER_LOGIN_REQUEST_LIMIT=5
MEMBER_LOGIN_VERIFY_LIMIT=10
MEMBER_LOGIN_RATE_LIMIT_WINDOW_SECONDS=3600
GOOGLE_SHEET_FETCH_TIMEOUT_SECONDS=10
GOOGLE_SHEET_IMPORT_MAX_BYTES=2000000
